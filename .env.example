# Copy to .env in the project root. Never commit a real .env file.
# PostgreSQL connection for local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety
# In production, set to a long, unique random secret (at least 32 characters).
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
PORT=4000
NODE_ENV=development
# Used to decide whether a reading's date is in the future.
APP_TIMEZONE=Asia/Kolkata
# Seed-only local demo credentials; change them outside development.
SEED_EMAIL=demo@sweety.local
SEED_PASSWORD=Demo12345!

# Optional: separate disposable database for PostgreSQL-backed integration tests.
# Only database names ending with _test are permitted by the test safety check.
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sweety_test
